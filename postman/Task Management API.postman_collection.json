              "raw": "{{baseUrl}}/api/auth/token/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged-out refresh token is rejected (401)', function () { pm.response.to.have.status(401); });",
                  "pm.test('Refresh failure uses standard error envelope', function () { const body = pm.response.json(); pm.expect(body.success).to.eql(false); pm.expect(body.status_code).to.eql(401); });"
                ]
              }
            }
          ],

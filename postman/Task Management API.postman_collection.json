      "name": "Authentication",
      "item": [
        {
          "name": "Register employer",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{employerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"employer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('employerEmail', 'postman-employer-' + Date.now() + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Employer registered (201)', function () { pm.response.to.have.status(201); });",
                  "pm.test('Password is not returned', function () { pm.expect(pm.response.json()).not.to.have.property('password'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login employer",
          "request": {
            "auth": {
              "type": "noauth"

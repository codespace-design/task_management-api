          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds (200)', function () { pm.response.to.have.status(200); });",
                  "const tokens = pm.response.json();",
                  "pm.environment.set('employerAccessToken', tokens.access);",
                  "pm.environment.set('employerRefreshToken', tokens.refresh);",
                  "pm.test('Access and refresh tokens are returned', function () { pm.expect(tokens.access).to.be.a('string'); pm.expect(tokens.refresh).to.be.a('string'); });"
                ]
              }
            }
          ],
          "response": []

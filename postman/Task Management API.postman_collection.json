        {
          "name": "Refresh employer token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{employerRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh succeeds (200)', function () { pm.response.to.have.status(200); });",
                  "const previousRefresh = pm.environment.get('employerRefreshToken');",
                  "const tokens = pm.response.json();",
                  "pm.environment.set('employerAccessToken', tokens.access);",
                  "pm.environment.set('employerRefreshToken', tokens.refresh);",
                  "pm.test('Refresh token rotates', function () { pm.expect(tokens.refresh).to.not.equal(previousRefresh); });"
                ]
              }
            }
          ],
          "response": []
        },
